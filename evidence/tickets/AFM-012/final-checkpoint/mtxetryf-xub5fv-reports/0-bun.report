      <testcase name="pairs by frame index even when the two videos carry different timelines" classname="psnrAtFrames()" time="0.549674" file="src/regression-harness-psnr.test.ts" line="184" assertions="7" />
      <testcase name="deduplicates repeated frame indices without losing alignment" classname="psnrAtFrames()" time="0.316802" file="src/regression-harness-psnr.test.ts" line="196" assertions="4" />
      <testcase name="is insensitive to the order frame indices are supplied in" classname="psnrAtFrames()" time="0.166823" file="src/regression-harness-psnr.test.ts" line="209" assertions="1" />
      <testcase name="reports identical video as infinite PSNR, as the legacy method did" classname="psnrAtFrames()" time="0.168237" file="src/regression-harness-psnr.test.ts" line="215" assertions="2" />
      <testcase name="throws rather than mis-pairing when a frame is past the end of both videos" classname="psnrAtFrames()" time="0.080363" file="src/regression-harness-psnr.test.ts" line="221" assertions="1" />
      <testcase name="throws when only one input runs out of frames" classname="psnrAtFrames()" time="0.083542" file="src/regression-harness-psnr.test.ts" line="227" assertions="1" />
      <testcase name="still compares every requested frame when one input is merely shorter than the last index" classname="psnrAtFrames()" time="0.083909" file="src/regression-harness-psnr.test.ts" line="239" assertions="1" />
      <testcase name="returns an empty map when asked for nothing" classname="psnrAtFrames()" time="0.000076" file="src/regression-harness-psnr.test.ts" line="246" assertions="1" />
