      <testcase name="naive count drives chunkCount when below cap" classname="resolveChunkPlan" time="0.000047" file="src/services/distributed/plan.test.ts" line="199" assertions="2" />
      <testcase name="rejects non-positive totalFrames" classname="resolveChunkPlan" time="0.000138" file="src/services/distributed/plan.test.ts" line="206" assertions="3" />
