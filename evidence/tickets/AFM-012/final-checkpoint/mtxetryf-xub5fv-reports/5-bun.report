      <testcase name="explicit chunkSize wins: 660 frames + chunkSize=240 + maxParallelChunks=16 → 3 chunks" classname="resolveChunkPlan" time="0.000023" file="src/services/distributed/plan.test.ts" line="229" assertions="2" />
      <testcase name="auto-sizes when chunkSize=undefined: 660 frames + maxParallelChunks=16 → 16 chunks" classname="resolveChunkPlan" time="0.000016" file="src/services/distributed/plan.test.ts" line="237" assertions="2" />
      <testcase name="auto-size floor: tiny renders cap at MIN_CHUNK_SIZE rather than fragmenting infinitely" classname="resolveChunkPlan" time="0.000017" file="src/services/distributed/plan.test.ts" line="245" assertions="2" />
      <testcase name="tightens chunkCount so an explicit small chunkSize leaves no empty trailing slice" classname="resolveChunkPlan" time="0.000112" file="src/services/distributed/plan.test.ts" line="255" assertions="4" />
