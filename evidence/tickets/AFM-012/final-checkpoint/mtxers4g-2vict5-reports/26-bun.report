      <testcase name="returns 0 for an empty directory and caches that result" classname="frameDirMaxIndexCache" time="0.000193" file="src/services/frameDirCache.test.ts" line="89" assertions="4" />
      <testcase name="returns 0 for a missing directory and caches that result" classname="frameDirMaxIndexCache" time="0.000155" file="src/services/frameDirCache.test.ts" line="100" assertions="2" />
      <testcase name="caches the first read so subsequent readdir-mutations are not observed" classname="frameDirMaxIndexCache" time="0.000491" file="src/services/frameDirCache.test.ts" line="107" assertions="2" />
      <testcase name="clearMaxFrameIndex forces a re-read on the next call" classname="frameDirMaxIndexCache" time="0.000311" file="src/services/frameDirCache.test.ts" line="121" assertions="6" />
      <testcase name="clearMaxFrameIndex returns false when the path was not cached" classname="frameDirMaxIndexCache" time="0.000212" file="src/services/frameDirCache.test.ts" line="140" assertions="2" />
      <testcase name="isolates entries across multiple directories" classname="frameDirMaxIndexCache" time="0.003757" file="src/services/frameDirCache.test.ts" line="148" assertions="9" />
      <testcase name="cross-job isolation: cache is empty between jobs when callers honor the contract" classname="frameDirMaxIndexCache" time="0.004836" file="src/services/frameDirCache.test.ts" line="176" assertions="7" />
      <testcase name="cross-job isolation: cache does not grow monotonically across many jobs" classname="frameDirMaxIndexCache" time="0.066815" file="src/services/frameDirCache.test.ts" line="202" assertions="40" />
      <testcase name="cross-job isolation: a job that forgets to clear leaks exactly its own entries (regression bound)" classname="frameDirMaxIndexCache" time="0.001385" file="src/services/frameDirCache.test.ts" line="226" assertions="2" />
      <testcase name="bounded LRU: cache size never exceeds MAX_ENTRIES under sustained insert pressure" classname="frameDirMaxIndexCache" time="0.006169" file="src/services/frameDirCache.test.ts" line="261" assertions="1" />
      <testcase name="bounded LRU: oldest entries are evicted first, newest are retained" classname="frameDirMaxIndexCache" time="0.003974" file="src/services/frameDirCache.test.ts" line="272" assertions="14" />
      <testcase name="bounded LRU: re-accessing an entry bumps its recency and protects it from eviction" classname="frameDirMaxIndexCache" time="0.003733" file="src/services/frameDirCache.test.ts" line="298" assertions="4" />
