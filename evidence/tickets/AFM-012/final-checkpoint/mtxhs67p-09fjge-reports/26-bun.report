      <testcase name="caches the first read so subsequent readdir-mutations are not observed" classname="frameDirMaxIndexCache" time="0.000648" file="src/services/frameDirCache.test.ts" line="107" assertions="2" />
      <testcase name="clearMaxFrameIndex forces a re-read on the next call" classname="frameDirMaxIndexCache" time="0.000561" file="src/services/frameDirCache.test.ts" line="121" assertions="6" />
      <testcase name="clearMaxFrameIndex returns false when the path was not cached" classname="frameDirMaxIndexCache" time="0.000314" file="src/services/frameDirCache.test.ts" line="140" assertions="2" />
      <testcase name="isolates entries across multiple directories" classname="frameDirMaxIndexCache" time="0.007751" file="src/services/frameDirCache.test.ts" line="148" assertions="9" />
      <testcase name="cross-job isolation: cache is empty between jobs when callers honor the contract" classname="frameDirMaxIndexCache" time="0.007628" file="src/services/frameDirCache.test.ts" line="176" assertions="7" />
