      <testcase name="cross-job isolation: a job that forgets to clear leaks exactly its own entries (regression bound)" classname="frameDirMaxIndexCache" time="0.002765" file="src/services/frameDirCache.test.ts" line="226" assertions="2" />
      <testcase name="bounded LRU: cache size never exceeds MAX_ENTRIES under sustained insert pressure" classname="frameDirMaxIndexCache" time="0.011197" file="src/services/frameDirCache.test.ts" line="261" assertions="1" />
      <testcase name="bounded LRU: oldest entries are evicted first, newest are retained" classname="frameDirMaxIndexCache" time="0.008174" file="src/services/frameDirCache.test.ts" line="272" assertions="14" />
