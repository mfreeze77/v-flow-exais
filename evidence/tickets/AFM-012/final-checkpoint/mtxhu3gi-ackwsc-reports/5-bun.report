      <testcase name="auto-sizes when chunkSize=undefined: 660 frames + maxParallelChunks=16 → 16 chunks" classname="resolveChunkPlan" time="0.000014" file="src/services/distributed/plan.test.ts" line="237" assertions="2" />
      <testcase name="auto-size floor: tiny renders cap at MIN_CHUNK_SIZE rather than fragmenting infinitely" classname="resolveChunkPlan" time="0.000013" file="src/services/distributed/plan.test.ts" line="245" assertions="2" />
