      <testcase name="targetChunkFrames omitted is a no-op: identical to the 3-arg auto-sized result" classname="resolveChunkPlan" time="0.000087" file="src/services/distributed/plan.test.ts" line="294" assertions="12" />
      <testcase name="targetChunkFrames collapses a short video to fewer chunks than the parallelism cap" classname="resolveChunkPlan" time="0.000032" file="src/services/distributed/plan.test.ts" line="306" assertions="2" />
