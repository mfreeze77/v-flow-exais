{
  "name": "v-flow-exais",
  "private": true,
  "type": "module",
  "description": "V-Flow EXAIS - one Studio for typed architecture diagrams and real video production. Built from owned Archify diagram-engine and HyperFrames composition sources.",
  "license": "SEE licenses/",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "dev": "bun run studio",
    "studio": "bun run --filter @hyperframes/studio dev",

    "build": "bun run build:stage1 && bun run build:stage2 && bun run build:stage3 && bun run build:stage4 && bun run build:stage5",
    "build:stage1": "bun run --filter '@hyperframes/{project-model,parsers,lint,studio-server}' build",
    "build:stage2": "bun run --filter @hyperframes/core build && bun run --filter @hyperframes/diagram-engine build",
    "build:stage3": "bun run --filter '@hyperframes/{engine,producer,player,studio,shader-transitions,aws-lambda,gcp-cloud-run,sdk,diagram-viewer,diagram-motion}' build",
    "build:stage4": "bun run --filter @hyperframes/cli build",
    "build:stage5": "bun run --filter @hyperframes/sdk-playground build",
    "build:hyperframes-runtime:modular": "bun run --filter @hyperframes/core build:hyperframes-runtime:modular",

    "test": "bun run test:unit",
    "test:unit": "bun run --filter '*' test",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:regression": "bun run --cwd packages/producer test:regression",

    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",

    "preflight:sources": "bun run tools/import/preflight.ts",
    "check:dockerfile-workspaces": "bun run tools/check-dockerfile-workspaces.ts",

    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm workspace bun run test:unit",
    "docker:shell": "docker compose run --rm workspace bash"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
