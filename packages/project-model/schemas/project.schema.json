{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://v-flow.local/schemas/project-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "revision",
    "documents",
    "scenes",
    "output",
    "policy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "revision": { "type": "integer", "minimum": 0 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "authoritative"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": {
            "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle", "native"]
          },
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "authoritative": { "const": true }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "documentId", "startFrame", "durationFrames", "presentation"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["diagram", "native"] },
          "documentId": { "$ref": "#/$defs/id" },
          "startFrame": { "type": "integer", "minimum": 0 },
          "durationFrames": { "type": "integer", "minimum": 1, "maximum": 216000 },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "focusObjectIds", "relationshipIds"],
            "properties": {
              "title": { "type": "string", "maxLength": 240 },
              "subtitle": { "type": "string", "maxLength": 600 },
              "focusObjectIds": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              },
              "relationshipIds": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "regenerationConflicts": {
      "type": "array",
      "maxItems": 30000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "documentId",
          "sceneId",
          "targetId",
          "field",
          "detail",
          "createdByCommandId",
          "detectedRevision",
          "originalTargets"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "const": "orphaned-target" },
          "documentId": { "$ref": "#/$defs/id" },
          "sceneId": { "$ref": "#/$defs/id" },
          "targetId": { "$ref": "#/$defs/id" },
          "field": { "enum": ["focusObjectIds", "relationshipIds"] },
          "detail": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "createdByCommandId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "detectedRevision": { "type": "integer", "minimum": 1 },
          "originalTargets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "https://v-flow.local/schemas/asset-v1.json" }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 240, "maximum": 7680, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 240, "maximum": 7680, "multipleOf": 2 },
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1, "maximum": 240000 },
            "denominator": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSharing", "htmlTrust"],
      "properties": {
        "sourceSharing": { "enum": ["private", "approved-public"] },
        "htmlTrust": { "enum": ["blocked", "trusted-local"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
  }
}
