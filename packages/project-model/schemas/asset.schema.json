{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://v-flow.local/schemas/asset-v1.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "path",
        "byteLength",
        "origin",
        "rights",
        "kind",
        "mediaType",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^asset-[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[a-f0-9]{64}\\.(wav|png)$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "const": "local-file"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "rights": {
          "const": "unverified"
        },
        "kind": {
          "const": "audio"
        },
        "mediaType": {
          "const": "audio/wav"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measured", "codec", "durationSeconds", "sampleRate", "channels"],
          "properties": {
            "measured": {
              "const": true
            },
            "codec": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]{1,64}$"
            },
            "durationSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sampleRate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 768000
            },
            "channels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "path",
        "byteLength",
        "origin",
        "rights",
        "kind",
        "mediaType",
        "metadata"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^asset-[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/[a-f0-9]{64}\\.(wav|png)$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": {
              "const": "local-file"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "rights": {
          "const": "unverified"
        },
        "kind": {
          "const": "image"
        },
        "mediaType": {
          "const": "image/png"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measured", "codec", "width", "height"],
          "properties": {
            "measured": {
              "const": true
            },
            "codec": {
              "const": "png"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            }
          }
        }
      }
    }
  ]
}
