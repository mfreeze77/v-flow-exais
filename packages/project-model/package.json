{
  "name": "@hyperframes/project-model",
  "version": "0.1.0",
  "private": true,
  "description": "Shared project envelope, document kinds, stable identities, command validation and atomic revision history (contracts C01, C03, C04, C05).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./storage": {
      "bun": "./src/storage/commit.ts",
      "node": "./dist/storage.js",
      "import": "./src/storage/commit.ts",
      "types": "./src/storage/commit.ts"
    },
    "./revisions": {
      "bun": "./src/storage/revisions.ts",
      "node": "./dist/revisions.js",
      "import": "./src/storage/revisions.ts",
      "types": "./src/storage/revisions.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
